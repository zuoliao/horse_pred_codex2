{
  "schema_version": 1,
  "experiment_id": "pv_004_margin_rating_score",
  "parent_experiment_id": "pv_001_candidate_signed_time_gap",
  "hypothesis": "The frozen margin-aware Elo pre-race raw score adds information beyond the accepted lean history and PV-01 signed time-gap feature",
  "seed": 42,
  "model_configs": {
    "binary": "configs/exp_001_binary.json",
    "lambdarank": "configs/exp_002_lambdarank.json"
  },
  "feature_selection": {
    "include": [
      "current_context",
      "horse_performance",
      "form_workload",
      "suitability",
      "connections",
      "rating_value",
      "race_content_time",
      "margin_rating"
    ]
  },
  "candidate_column": "margin_rating__score_pre",
  "rating_spec": {
    "family": "pairwise_elo",
    "initial_rating": 1500.0,
    "k": 48.0,
    "scale": 200.0,
    "pairwise_actual": "time_margin_logistic",
    "time_margin_tau_seconds_per_1000m": 0.125
  },
  "comparators": {
    "primary": "configs/performance/pv_001_candidate_signed_time_gap.json",
    "lambdarank_incumbent": "configs/ablations/abl_006_drop_field_relative.json"
  },
  "bootstrap": {
    "moving_block_dates": 4,
    "resamples": 10000,
    "seed": 20240830
  },
  "acceptance": {
    "probability_path": {
      "log_loss_improvement_min": 0.002,
      "log_loss_improvement_ci_lower_strictly_positive": true,
      "brier_improvement_min": 0.0,
      "ndcg_at_3_improvement_min": -0.002,
      "top_1_improvement_min": -0.005
    },
    "ranking_path": {
      "ndcg_at_3_improvement_ci_lower_strictly_positive": true,
      "log_loss_improvement_min": -0.002,
      "brier_improvement_min": -0.001,
      "top_1_improvement_min": -0.005
    }
  },
  "scope": {
    "model_fit_years": [2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021],
    "model_validation_year": 2022,
    "calibration_year": 2023,
    "development_year": 2024,
    "retrospective_2025_used": false,
    "odds_used": false
  }
}
